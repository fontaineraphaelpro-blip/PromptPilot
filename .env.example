# App
# Prod : https://www.promptpilot.fr (obligatoire pour sitemap / Search Console)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mode vente (CTAs Pro, checkout sur la home) — false pour désactiver
# NEXT_PUBLIC_SALES_MODE=true
# NEXT_PUBLIC_MARKETING_PRO_PUSH=false

# Railway PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/railway

# Auth NextAuth (générer: openssl rand -base64 32) — obligatoire en prod
AUTH_SECRET=
# Alias accepté si tu l'avais déjà sur Railway :
# NEXTAUTH_SECRET=
AUTH_URL=http://localhost:3000

# OpenAI — obligatoire pour la génération
OPENAI_API_KEY=
# Modèle Rapide (défaut gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
# Modèle Détaillé + Expert (défaut gpt-4o — meilleure qualité)
# OPENAI_MODEL_QUALITY=gpt-4o

# Stripe — obligatoire pour les paiements
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Abonnements (Price ID price_... ou Payment Link https://buy.stripe.com/...)
# Starter 9€ — fallback legacy si absente :
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_...
# Fallback Accepté (ancien nom Pro 9€) :
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
# Pro affiché (plan interne « plus ») 19€
NEXT_PUBLIC_STRIPE_PLUS_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_CREATOR_PRICE_ID=price_...

# Option B : Payment Links aussi acceptés
# NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=https://buy.stripe.com/...
# Si Payment Links : ajoute aussi les vrais price_ pour les webhooks :
# STRIPE_STARTER_PRICE_ID=price_...
# STRIPE_PLUS_PRICE_ID=price_...
# STRIPE_CREATOR_PRICE_ID=price_...
# STRIPE_PRO_PRICE_ID=price_...  (legacy alias → starter)

# Tarifs annuels (optionnel — active le toggle sur /pricing)
# NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID_YEARLY=price_...
# NEXT_PUBLIC_STRIPE_PLUS_PRICE_ID_YEARLY=price_...
# NEXT_PUBLIC_STRIPE_CREATOR_PRICE_ID_YEARLY=price_...
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_YEARLY=price_...  (legacy → starter)

# One-shot / packs — optionnel : sans ces vars, Checkout crée le prix à la volée
# (price_data) depuis commerce-products.ts. Garde-les seulement si tu as déjà des price_...
# NEXT_PUBLIC_STRIPE_CREDITS_10_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_CREDITS_30_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_CREDITS_100_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_EXPERT_UNLOCK_PRICE_ID=price_...
# NEXT_PUBLIC_STRIPE_WORKFLOW_PACK_PRICE_ID=price_...

# Support & emails (Resend — https://resend.com)
SUPPORT_EMAIL=support@promptpilot.app
# RESEND_API_KEY=re_...
# EMAIL_FROM=PromptPilot <noreply@votredomaine.com>

# Vidéo démo home (optionnel — URL MP4 ou WebM)
# NEXT_PUBLIC_DEMO_VIDEO_URL=https://...

# Analytics & chat (optionnel)
# Google Analytics 4 (défaut : G-ML5QFPTM8H si non défini)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-ML5QFPTM8H
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=promptpilot.app
# NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Monitoring (optionnel — installer @sentry/nextjs si besoin)
# SENTRY_DSN=
